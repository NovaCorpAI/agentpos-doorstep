# AgentPOS Doorstep. Copy to .env; never commit .env.

# Ring app credentials (Ring Developer Console, https://developer.amazon.com/ring/console).
# Client Secret and HMAC Signature Key are shown once at app creation and cannot be regenerated.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# One key, two uses: webhook signatures (X-Signature, sha256=<hex>) and account-linking nonces (base64url).
RING_WEBHOOK_HMAC_KEY=

# Public HTTPS base URL. Ring delivers webhooks to $PUBLIC_BASE_URL/ring/webhook and
# redirects back to $PUBLIC_BASE_URL/ring/link/callback (must match the console exactly).
PUBLIC_BASE_URL=https://doorstep.example.com
# Override only if the registered redirect URI differs from the default above.
# RING_REDIRECT_URI=

# Ring endpoints (defaults are production; override for a mock during tests).
# RING_API_BASE_URL=https://api.amazonvision.com
# RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
# RING_AUTHORIZE_URL=https://account.ring.com/account/integrations/partner-link/authorize

# Where orders come from (AgentPOS merchant API or store webhook secret).
AGENTPOS_ORDER_WEBHOOK_SECRET=

# Attestation signing key: Ed25519 via @stellar/stellar-sdk. Holds no funds. Env only.
DOORSTEP_ATTESTATION_SECRET=

# AWS (matching agent and scheduler). Region is us-east-1 for Bedrock and AgentCore.
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=amazon.nova-2-lite-v1:0
# Verify the current Claude Sonnet model id in the Bedrock console before step 4.
BEDROCK_MODEL_STRONG=
AGENTCORE_RUNTIME_ARN=

# Local server and storage (node:sqlite).
PORT=3000
DOORSTEP_DB_PATH=./.data/doorstep.sqlite
